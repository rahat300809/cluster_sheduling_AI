rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return request.auth.uid == ownerId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return getUserRole() == 'admin';
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // Never allow user deletion from client
    }

    // ─── Devices ────────────────────────────────────────────────────────────
    match /devices/{deviceId} {
      // Anyone authenticated can read devices during pairing
      allow read: if isAuthenticated();
      // Device registration: allow any authenticated user to create
      allow create: if isAuthenticated();
      // Only owner can update (rename, etc.)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        // Allow pairing update (ownerId is being set)
        resource.data.paired == false
      );
      // Only owner can delete
      allow delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    // ─── Clusters ───────────────────────────────────────────────────────────
    match /clusters/{clusterId} {
      allow read: if isAuthenticated() && isOwner(resource.data.ownerId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.ownerId);
      allow delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    // ─── Jobs ───────────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read: if isAuthenticated() && isOwner(resource.data.ownerId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.ownerId);
      allow delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    // ─── Commands ───────────────────────────────────────────────────────────
    match /commands/{commandId} {
      allow read: if isAuthenticated() && isOwner(resource.data.issuedBy);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.issuedBy);
      allow delete: if isAuthenticated() && isOwner(resource.data.issuedBy);
    }
  }
}
