{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "database": {
    "rules": "firebase/database.rules.json"
  },
  "hosting": {
    "public": "dashboard/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true
  }
}
